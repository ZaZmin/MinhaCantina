@page "/Login"

<PageTitle>Entrar</PageTitle>

<h3>Login</h3>

<main class="p-3 text-primary-emphasis bg-primary-subtle border border-primary-subtle rounded-3 mt-5 " style="max-width: 500px;">

<div class=" mb-3 ">
 <label class="form-label"> Nome de Usuário </label>
  <input type="text" class="form-control" placeholder="Nome do Usuário" aria-label="Username" aria-describedby="basic-addon1">
</div>

<div class="mb-3">
    <label for="exampleInputPassword1" class="form-label">Senha</label>
    <input type="password" class="form-control" placeholder="Senha" id="exampleInputPassword1">
</div>

<div class="form-check">
  <input class="form-check-input" type="checkbox" value="" id="checkDefault">
  <label class="form-check-label" for="checkDefault">
    Deixar as informações salvas no seu dispositivo?
  </label>
  </div>

  <div>
    <button class="btn btn-primary " >
        Entrar
    </button>
  </div>
</main>
